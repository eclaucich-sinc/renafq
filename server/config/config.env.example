# Copiar este archivo a "config.env" (no commitear) y completar con valores reales.

PORT=5001
NODE_ENV=development

# Mongo local levantado con docker-compose (ver .env.example en la raíz para las credenciales).
# authSource=admin es necesario porque el usuario se crea en esa base (MONGO_INITDB_ROOT_*).
MONGO_URI=mongodb://<usuario>:<password>@localhost:27017/fqdb?authSource=admin

JWT_SECRET=
JWT_EXPIRES=30d
COOKIE_EXPIRES=30
