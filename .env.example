# Copiar este archivo a ".env" (no commitear) y completar con credenciales reales.
# Usado por docker-compose.yml para levantar el contenedor de MongoDB local.
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=

# Opcional: solo si el puerto 27017 ya está ocupado en esta máquina (default: 27017)
# MONGO_HOST_PORT=27018

# Opcional: solo si el CPU del host no soporta AVX (Mongo 5.0+ lo requiere)
# MONGO_IMAGE=mongo:4.4

# Opcional: para que otras apps/clientes conectados a la red interna o VPN
# puedan acceder (ej. Compass). Dejar sin definir = solo accesible localmente
# (127.0.0.1). Usar 0.0.0.0 para que siga funcionando también vía localhost
# (necesario para que la propia app del servidor no se corte).
# MONGO_BIND_IP=0.0.0.0
